# Copy to .env — python setup.py (repo root) writes this file for you.
# Numbers allowed to talk to Atlas, comma-separated, digits only. Empty = allow all
# (don't: Atlas has shell access).
ALLOWED_JIDS=15551234567
JARVIS_URL=http://127.0.0.1:18923
JARVIS_AUTO_REPLY=true

# Optional email -> WhatsApp notifier (leave unset to disable it)
#GMAIL_USER=you@gmail.com
#GMAIL_APP_PASSWORD=your-app-password
#NOTIFY_PHONE=15551234567
#BRIDGE_URL=http://localhost:3000
#POLL_SECONDS=60
