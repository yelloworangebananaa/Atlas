# Copy to .env — python setup.py fills these in for you; edit by hand only if you like.
# Model API key — only needed for a remote backend (e.g. build.nvidia.com).
# Local backends (Ollama, LM Studio) need no key.
JARVIS_LLM_API_KEY=

# Gmail for the comms-bridge connector (read/send email) — optional.
# Use an App Password: https://myaccount.google.com/apppasswords
#GMAIL_USER=you@gmail.com
#GMAIL_APP_PASSWORD=your-app-password
